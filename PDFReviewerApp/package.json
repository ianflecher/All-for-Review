{
  "name": "pdfreviewerapp",
  "version": "1.0.0",
  "main": "index.ts",
  "author": "PDF Quiz Reviewer",
  "description": "Offline PDF summarizer, flashcard and quiz generator.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "electron:start": "npm run build:web && electron electron/main.js",
    "build:android": "eas build -p android --profile preview",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:linux": "npm run build:web && electron-builder --linux",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepare:ocr": "node scripts/prepare-ocr-assets.js",
    "postinstall": "node scripts/prepare-ocr-assets.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.2.1",
    "expo": "~55.0.8",
    "expo-asset": "~55.0.10",
    "expo-document-picker": "~55.0.9",
    "expo-file-system": "~55.0.11",
    "expo-notifications": "~55.0.27",
    "expo-sharing": "~55.0.14",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^3.11.174",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "~19.2.2",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.2",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^6.1.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fil": "^1.0.0"
  },
  "private": true,
  "build": {
    "appId": "com.idfreviewer.app",
    "productName": "PDF Quiz Reviewer",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/desktop-icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/desktop-icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/desktop-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
