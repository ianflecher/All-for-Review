{
  "name": "pdfreviewerapp",
  "version": "1.0.0",
  "main": "index.ts",
  "author": "PDF Quiz Reviewer",
  "description": "Offline PDF summarizer, flashcard and quiz generator.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "electron:start": "npm run build:web && electron electron/main.js",
    "build:android": "eas build -p android --profile preview",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:linux": "npm run build:web && electron-builder --linux"
  },
  "dependencies": {
    "@dariyd/react-native-text-recognition": "^2.0.20",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.2.1",
    "@react-navigation/stack": "^7.8.8",
    "expo": "~55.0.8",
    "expo-asset": "~55.0.10",
    "expo-document-picker": "~55.0.9",
    "expo-file-system": "~55.0.11",
    "expo-sharing": "~55.0.14",
    "expo-status-bar": "~55.0.4",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^3.11.174",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-document-picker": "^9.3.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-pdf": "^7.0.4",
    "react-native-pdf-lib": "^1.0.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "~19.2.2",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "resolutions": {
    "expo-file-system": "~15.4.0"
  },
  "build": {
    "appId": "com.idfreviewer.app",
    "productName": "PDF Quiz Reviewer",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
